# RAGent 连接参数模板：复制成 .env 后填自己的值（.env 已被 gitignore）
#
# 服务地址。比特严选演示环境是 9090；Docker 部署把后端藏在 nginx 后面时，
# 用 nginx 暴露的地址，例如 http://localhost/api/ragent
RAGENT_BASE_URL=http://localhost:9090/api/ragent

# 评测账号。RAGent 后端 t_user 表里必须已有这个账号，
# 服务端还要开启 app.eval.enabled=true 才有 /rag/eval 旁路接口。
RAGENT_USERNAME=
RAGENT_PASSWORD=
