# Copy this file to deploy/.env on the Linux server, fill every REPLACE_ME value,
# then run: chmod 600 deploy/.env

COMPOSE_PROJECT_NAME=ragent
TZ=Asia/Shanghai

# PostgreSQL / Redis
POSTGRES_DB=ragent
POSTGRES_USER=ragent
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD

# RustFS root S3 credentials. Do not use rustfsadmin/rustfsadmin in production.
# The access key must not contain '/'.
RUSTFS_ACCESS_KEY=REPLACE_WITH_UPPERCASE_ACCESS_KEY
RUSTFS_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_RUSTFS_SECRET

# The URL that a browser can reach. Use your domain after HTTPS is configured.
# Until then, replace YOUR_SERVER_PUBLIC_IP with the CVM public IP.
RAGENT_PUBLIC_BASE_URL=http://YOUR_SERVER_PUBLIC_IP/storage

# External AI and document-parsing credentials. Keep unused providers blank.
BAILIAN_API_KEY=REPLACE_ME
AIHUBMIX_API_KEY=
SILICONFLOW_API_KEY=REPLACE_ME
MINERU_API_KEY=REPLACE_ME
